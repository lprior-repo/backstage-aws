{
  "Comment": "TEST FIXTURE: synthetic account, ARN, and network identifiers; do not deploy. Approved portal rollout: idempotent DB bootstrap, fixed ECS deployment, and bounded readiness verification. Request data cannot choose infrastructure.",
  "QueryLanguage": "JSONata",
  "StartAt": "ValidateRequest",
  "States": {
    "AcquireReleaseLock": {
      "Arguments": {
        "ConditionExpression": "attribute_not_exists(LockId)",
        "Item": {
          "LockId": {
            "S": "portal"
          },
          "Owner": {
            "S": "{% $states.context.Execution.Id %}"
          }
        },
        "TableName": "backstage-release-lock"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "LockNotAcquired"
        }
      ],
      "Next": "SelectOperation",
      "Output": {
        "requestId": "{% $requestId %}"
      },
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDB.InternalServerError"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 2,
          "MaxDelaySeconds": 10
        }
      ],
      "TimeoutSeconds": 30,
      "Type": "Task"
    },
    "BootstrapContainerFailed": {
      "Assign": {
        "failureCause": "The db-bootstrap container did not report exit code zero. The portal was not updated. Inspect DB-bootstrap logs.",
        "failureError": "BootstrapContainerFailed"
      },
      "Next": "ReleaseFailedLock",
      "Type": "Pass"
    },
    "BootstrapDatabase": {
      "Arguments": {
        "Cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/backstage-cluster",
        "Count": 1,
        "EnableExecuteCommand": false,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "SecurityGroups": [
              "sg-11111111"
            ],
            "Subnets": [
              "subnet-11111111",
              "subnet-22222222"
            ]
          }
        },
        "StartedBy": "backstage-rollout",
        "TaskDefinition": "arn:aws:ecs:us-east-1:123456789012:task-definition/backstage-db-bootstrap:3"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "BootstrapTaskFailed"
        }
      ],
      "Next": "CheckBootstrapExit",
      "Output": "{% $states.result %}",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "ECS.ThrottlingException",
            "ECS.ServerException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 2,
          "MaxDelaySeconds": 10
        }
      ],
      "TimeoutSeconds": 300,
      "Type": "Task"
    },
    "BootstrapTaskFailed": {
      "Assign": {
        "failureCause": "The approved database task could not run or exceeded its five-minute limit. Inspect ECS stopped reason and DB-bootstrap logs.",
        "failureError": "BootstrapTaskFailed"
      },
      "Next": "ReleaseFailedLock",
      "Type": "Pass"
    },
    "CheckBootstrapExit": {
      "Choices": [
        {
          "Condition": "{% $count($states.input.Containers[Name = 'db-bootstrap']) = 1 and $states.input.Containers[Name = 'db-bootstrap'].ExitCode = 0 %}",
          "Next": "DeployPortal"
        }
      ],
      "Default": "BootstrapContainerFailed",
      "Type": "Choice"
    },
    "CheckDeployment": {
      "Choices": [
        {
          "Condition": "{% $states.input.Services[0].Deployments[Id = $deploymentId].RolloutState = 'FAILED' %}",
          "Next": "DeploymentFailed"
        },
        {
          "Condition": "{% $count($states.input.Services[0].Deployments) = 1 and $states.input.Services[0].Deployments[0].Id = $deploymentId and $states.input.Services[0].Deployments[0].Status = 'PRIMARY' and $states.input.Services[0].Deployments[0].TaskDefinition = 'arn:aws:ecs:us-east-1:123456789012:task-definition/backstage-portal:7' and $states.input.Services[0].Deployments[0].RolloutState = 'COMPLETED' and $states.input.Services[0].DesiredCount = 2 and $states.input.Services[0].RunningCount = 2 and $states.input.Services[0].PendingCount = 0 %}",
          "Next": "ReleaseSuccessfulLock"
        },
        {
          "Condition": "{% $attempts >= 59 %}",
          "Next": "RolloutTimedOut"
        }
      ],
      "Default": "IncrementAttempts",
      "Type": "Choice"
    },
    "CheckDrain": {
      "Choices": [
        {
          "Condition": "{% $count($states.input.Failures) = 0 and $count($states.input.Services) = 1 and $states.input.Services[0].Status = 'ACTIVE' and $states.input.Services[0].DesiredCount = 0 and $states.input.Services[0].RunningCount = 0 and $states.input.Services[0].PendingCount = 0 %}",
          "Next": "RotateDatabase"
        },
        {
          "Condition": "{% $drainAttempts >= 29 %}",
          "Next": "RotationFailed"
        }
      ],
      "Default": "IncrementDrain",
      "Type": "Choice"
    },
    "DeployPortal": {
      "Arguments": {
        "Cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/backstage-cluster",
        "DesiredCount": 2,
        "ForceNewDeployment": true,
        "Service": "backstage-portal",
        "TaskDefinition": "arn:aws:ecs:us-east-1:123456789012:task-definition/backstage-portal:7"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "UpdateServiceFailed"
        }
      ],
      "Next": "ValidateDeploymentReceipt",
      "Output": "{% $states.result %}",
      "Resource": "arn:aws:states:::aws-sdk:ecs:updateService",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Ecs.ThrottlingException",
            "Ecs.ServerException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 2,
          "MaxDelaySeconds": 10
        }
      ],
      "TimeoutSeconds": 30,
      "Type": "Task"
    },
    "DeploymentFailed": {
      "Assign": {
        "failureCause": "The requested ECS deployment failed. The ECS circuit breaker may restore the previous deployment.",
        "failureError": "DeploymentFailed"
      },
      "Next": "ReleaseFailedLock",
      "Type": "Pass"
    },
    "DescribeDrain": {
      "Arguments": {
        "Cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/backstage-cluster",
        "Services": [
          "backstage-portal"
        ]
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RotationFailed"
        }
      ],
      "Next": "CheckDrain",
      "Output": "{% $states.result %}",
      "Resource": "arn:aws:states:::aws-sdk:ecs:describeServices",
      "TimeoutSeconds": 30,
      "Type": "Task"
    },
    "DescribeService": {
      "Arguments": {
        "Cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/backstage-cluster",
        "Services": [
          "backstage-portal"
        ]
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "DescribeServiceFailed"
        }
      ],
      "Next": "ValidateServiceResponse",
      "Output": "{% $states.result %}",
      "Resource": "arn:aws:states:::aws-sdk:ecs:describeServices",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "Ecs.ThrottlingException",
            "Ecs.ServerException"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 2,
          "MaxDelaySeconds": 10
        }
      ],
      "TimeoutSeconds": 30,
      "Type": "Task"
    },
    "DescribeServiceFailed": {
      "Assign": {
        "failureCause": "ECS did not return exactly one active service without failures.",
        "failureError": "DescribeServiceFailed"
      },
      "Next": "ReleaseFailedLock",
      "Type": "Pass"
    },
    "DrainPortal": {
      "Arguments": {
        "Cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/backstage-cluster",
        "DesiredCount": 0,
        "Service": "backstage-portal",
        "TaskDefinition": "arn:aws:ecs:us-east-1:123456789012:task-definition/backstage-portal:7"
      },
      "Assign": {
        "drainAttempts": 0
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RotationFailed"
        }
      ],
      "Next": "WaitForDrain",
      "Resource": "arn:aws:states:::aws-sdk:ecs:updateService",
      "TimeoutSeconds": 30,
      "Type": "Task"
    },
    "ImageNotPublished": {
      "Cause": "Publish the application image to this stack's ECR repository and apply its image_digest before rollout.",
      "Error": "ImageNotPublished",
      "Type": "Fail"
    },
    "IncrementAttempts": {
      "Assign": {
        "attempts": "{% $attempts + 1 %}"
      },
      "Next": "WaitForService",
      "Output": {
        "requestId": "{% $requestId %}"
      },
      "Type": "Pass"
    },
    "IncrementDrain": {
      "Assign": {
        "drainAttempts": "{% $drainAttempts + 1 %}"
      },
      "Next": "WaitForDrain",
      "Type": "Pass"
    },
    "InvalidDeploymentReceipt": {
      "Assign": {
        "failureCause": "ECS did not return one primary deployment using the approved task definition. No success is assumed.",
        "failureError": "InvalidDeploymentReceipt"
      },
      "Next": "ReleaseFailedLock",
      "Type": "Pass"
    },
    "InvalidRequest": {
      "Cause": "Expected operation=rollout and requestId containing 1-64 letters, digits, hyphens, or underscores.",
      "Error": "InvalidRequest",
      "Type": "Fail"
    },
    "LockNotAcquired": {
      "Cause": "Another release holds the lock, or DynamoDB denied acquisition. No service mutation was attempted. Check the lock and execution history.",
      "Error": "ReleaseLockNotAcquired",
      "Type": "Fail"
    },
    "LockReleaseFailed": {
      "Cause": "The lock could not be released conditionally. Inspect this execution and ECS before explicit lock recovery.",
      "Error": "ReleaseLockRecoveryRequired",
      "Type": "Fail"
    },
    "ReleaseFailed": {
      "Cause": "{% $failureCause %}",
      "Error": "{% $failureError %}",
      "Type": "Fail"
    },
    "ReleaseFailedLock": {
      "Arguments": {
        "ConditionExpression": "#owner = :owner",
        "ExpressionAttributeNames": {
          "#owner": "Owner"
        },
        "ExpressionAttributeValues": {
          ":owner": {
            "S": "{% $states.context.Execution.Id %}"
          }
        },
        "Key": {
          "LockId": {
            "S": "portal"
          }
        },
        "TableName": "backstage-release-lock"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "LockReleaseFailed"
        }
      ],
      "Next": "ReleaseFailed",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDB.InternalServerError"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 2,
          "MaxDelaySeconds": 10
        }
      ],
      "TimeoutSeconds": 30,
      "Type": "Task"
    },
    "ReleaseSuccessfulLock": {
      "Arguments": {
        "ConditionExpression": "#owner = :owner",
        "ExpressionAttributeNames": {
          "#owner": "Owner"
        },
        "ExpressionAttributeValues": {
          ":owner": {
            "S": "{% $states.context.Execution.Id %}"
          }
        },
        "Key": {
          "LockId": {
            "S": "portal"
          }
        },
        "TableName": "backstage-release-lock"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "LockReleaseFailed"
        }
      ],
      "Next": "RolloutSucceeded",
      "Resource": "arn:aws:states:::dynamodb:deleteItem",
      "Retry": [
        {
          "BackoffRate": 2,
          "ErrorEquals": [
            "DynamoDB.ProvisionedThroughputExceededException",
            "DynamoDB.RequestLimitExceeded",
            "DynamoDB.InternalServerError"
          ],
          "IntervalSeconds": 2,
          "JitterStrategy": "FULL",
          "MaxAttempts": 2,
          "MaxDelaySeconds": 10
        }
      ],
      "TimeoutSeconds": 30,
      "Type": "Task"
    },
    "RememberDeployment": {
      "Assign": {
        "attempts": 0,
        "deploymentId": "{% $states.input.Service.Deployments[Status = 'PRIMARY'].Id %}"
      },
      "Next": "WaitForService",
      "Output": {
        "requestId": "{% $requestId %}"
      },
      "Type": "Pass"
    },
    "RememberRequest": {
      "Assign": {
        "operation": "{% $states.input.operation %}",
        "requestId": "{% $states.input.requestId %}"
      },
      "Next": "AcquireReleaseLock",
      "Output": {
        "operation": "{% $states.input.operation %}",
        "requestId": "{% $states.input.requestId %}"
      },
      "Type": "Pass"
    },
    "RolloutSucceeded": {
      "Output": {
        "deploymentId": "{% $deploymentId %}",
        "operation": "{% $operation %}",
        "portalUrl": "https://backstage.example.com",
        "requestId": "{% $requestId %}",
        "serviceArn": "arn:aws:ecs:us-east-1:123456789012:service/backstage-cluster/backstage-portal",
        "status": "SUCCEEDED",
        "taskDefinitionArn": "arn:aws:ecs:us-east-1:123456789012:task-definition/backstage-portal:7"
      },
      "Type": "Succeed"
    },
    "RolloutTimedOut": {
      "Assign": {
        "failureCause": "The requested deployment did not stabilize within 60 polls. A replacement deployment or rollback cannot satisfy this check. Inspect ECS events.",
        "failureError": "RolloutTimedOut"
      },
      "Next": "ReleaseFailedLock",
      "Type": "Pass"
    },
    "RotateDatabase": {
      "Arguments": {
        "Cluster": "arn:aws:ecs:us-east-1:123456789012:cluster/backstage-cluster",
        "Count": 1,
        "EnableExecuteCommand": false,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "SecurityGroups": [
              "sg-11111111"
            ],
            "Subnets": [
              "subnet-11111111",
              "subnet-22222222"
            ]
          }
        },
        "StartedBy": "backstage-db-rotation",
        "TaskDefinition": "arn:aws:ecs:us-east-1:123456789012:task-definition/backstage-db-rotate:3"
      },
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "RotationFailed"
        }
      ],
      "Next": "CheckBootstrapExit",
      "Output": "{% $states.result %}",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "TimeoutSeconds": 300,
      "Type": "Task"
    },
    "RotationFailed": {
      "Assign": {
        "failureCause": "Rotation maintenance did not complete. Service may be drained. Keep it stopped until the AWSCURRENT application secret and database are reconciled by a normal rollout.",
        "failureError": "DatabaseRotationFailed"
      },
      "Next": "ReleaseFailedLock",
      "Type": "Pass"
    },
    "SelectOperation": {
      "Choices": [
        {
          "Condition": "{% $operation = 'rotateDatabase' %}",
          "Next": "DrainPortal"
        }
      ],
      "Default": "BootstrapDatabase",
      "Type": "Choice"
    },
    "UpdateServiceFailed": {
      "Assign": {
        "failureCause": "ECS rejected or timed out the approved service update. Inspect execution history and ECS service events.",
        "failureError": "UpdateServiceFailed"
      },
      "Next": "ReleaseFailedLock",
      "Type": "Pass"
    },
    "ValidateDeploymentReceipt": {
      "Choices": [
        {
          "Condition": "{% $count($states.input.Service.Deployments[Status = 'PRIMARY']) = 1 and $states.input.Service.Deployments[Status = 'PRIMARY'].TaskDefinition = 'arn:aws:ecs:us-east-1:123456789012:task-definition/backstage-portal:7' %}",
          "Next": "RememberDeployment"
        }
      ],
      "Default": "InvalidDeploymentReceipt",
      "Type": "Choice"
    },
    "ValidateRequest": {
      "Choices": [
        {
          "Condition": "{% $type($states.input.requestId) = 'string' ? ($exists($match($states.input.requestId, /^[A-Za-z0-9_-]{1,64}$/)) and $states.input.operation = 'rollout') : false %}",
          "Next": "ImageNotPublished"
        }
      ],
      "Default": "InvalidRequest",
      "Type": "Choice"
    },
    "ValidateServiceResponse": {
      "Choices": [
        {
          "Condition": "{% $count($states.input.Failures) = 0 and $count($states.input.Services) = 1 and $states.input.Services[0].Status = 'ACTIVE' %}",
          "Next": "CheckDeployment"
        }
      ],
      "Default": "DescribeServiceFailed",
      "Type": "Choice"
    },
    "WaitForDrain": {
      "Next": "DescribeDrain",
      "Seconds": 5,
      "Type": "Wait"
    },
    "WaitForService": {
      "Next": "DescribeService",
      "Seconds": 10,
      "Type": "Wait"
    }
  },
  "TimeoutSeconds": 1200
}
