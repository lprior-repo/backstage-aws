aws_account_id  = "123456789012" # Replace with the intended AWS account.
aws_region      = "us-east-1"
name            = "backstage"
environment     = "production"
domain_name     = "backstage.example.com"
route53_zone_id = "Z0123456789EXAMPLE"

# Documentation-only address. Replace with your corporate/VPN public egress IP.
# Explicitly choose 0.0.0.0/0 only if an internet-wide portal is intended.
allowed_ingress_cidrs = ["203.0.113.10/32"]

# First apply leaves service at zero tasks and the workflow disabled.
image_digest = null

# Published image.auto.tfvars.json sets image_digest after a successful ECR push.
portal_desired_count = 2
single_nat_gateway   = false
database_multi_az    = true
deletion_protection  = true

tags = { Owner = "platform" }
