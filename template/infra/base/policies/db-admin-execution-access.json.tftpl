{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": ${jsonencode(secret_arns)}
    },
    {
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": ${jsonencode(kms_key_arn)},
      "Condition": {
        "StringEquals": {
          "kms:ViaService": ${jsonencode(kms_via_service)}
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": ${jsonencode(log_group_arn)}
    }
  ]
}
