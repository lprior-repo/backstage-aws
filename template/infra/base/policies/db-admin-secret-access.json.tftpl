{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["secretsmanager:GetSecretValue"],
      "Resource": ${jsonencode(secret_arns)}
    },
    {
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": ${jsonencode(kms_key_arn)},
      "Condition": {
        "StringEquals": {
          "kms:ViaService": ${jsonencode(kms_via_service)}
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ${jsonencode(seed_object_arn)}
    },
    {
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": ${jsonencode(kms_key_arn)},
      "Condition": {
        "StringEquals": {
          "kms:ViaService": ${jsonencode(s3_via_service)}
        },
        "StringLike": {
          "kms:EncryptionContext:aws:s3:arn": ${jsonencode(seed_object_arn)}
        }
      }
    }
  ]
}
