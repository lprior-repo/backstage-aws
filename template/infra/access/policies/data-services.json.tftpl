{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid":"CreateProjectSecrets","Effect":"Allow","Action":["secretsmanager:CreateSecret","secretsmanager:TagResource"],"Resource":[${jsonencode(project_secrets_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)},"aws:RequestTag/Project":${jsonencode(project)}}}},
    {"Sid":"ManageOwnedProjectSecrets","Effect":"Allow","Action":["secretsmanager:DescribeSecret","secretsmanager:GetResourcePolicy","secretsmanager:ListSecretVersionIds","secretsmanager:PutSecretValue","secretsmanager:GetSecretValue","secretsmanager:UpdateSecret","secretsmanager:DeleteSecret","secretsmanager:RestoreSecret","secretsmanager:UpdateSecretVersionStage"],"Resource":[${jsonencode(project_secrets_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)},"aws:ResourceTag/Project":${jsonencode(project)}}}},
    {"Sid":"TagOwnedProjectSecrets","Effect":"Allow","Action":["secretsmanager:TagResource"],"Resource":[${jsonencode(project_secrets_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)},"aws:ResourceTag/Project":${jsonencode(project)},"aws:RequestTag/Project":${jsonencode(project)}},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","ManagedBy","Environment"]}}},
    {"Sid":"UntagOwnedProjectSecretsWithoutChangingOwner","Effect":"Allow","Action":["secretsmanager:UntagResource"],"Resource":[${jsonencode(project_secrets_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)},"aws:ResourceTag/Project":${jsonencode(project)}},"ForAllValues:StringEquals":{"aws:TagKeys":["ManagedBy","Environment"]}}},
    {"Sid":"CreateAndTagRdsManagedSecret","Effect":"Allow","Action":["secretsmanager:CreateSecret","secretsmanager:TagResource"],"Resource":[${jsonencode(rds_secret_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)}}}},
    {"Sid":"ManagedRdsPrimarySecretReadOnly","Effect":"Allow","Action":["secretsmanager:DescribeSecret","secretsmanager:GetSecretValue"],"Resource":[${jsonencode(rds_secret_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)},"secretsmanager:ResourceTag/aws:secretsmanager:owningService":"rds","secretsmanager:ResourceTag/aws:rds:primaryDBInstanceArn":${jsonencode(rds_instance_arn)}}}},
    {"Sid":"EcrAuthorizationTokenGlobal","Effect":"Allow","Action":["ecr:GetAuthorizationToken"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)}}}},
    {"Sid":"CreateProjectRepository","Effect":"Allow","Action":["ecr:CreateRepository"],"Resource":[${jsonencode(repository_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)},"aws:RequestTag/Project":${jsonencode(project)}}}},
    {"Sid":"ManageOwnedProjectRepository","Effect":"Allow","Action":["ecr:DescribeRepositories","ecr:ListTagsForResource","ecr:DeleteRepository","ecr:PutImageTagMutability","ecr:PutImageScanningConfiguration","ecr:PutLifecyclePolicy","ecr:GetLifecyclePolicy","ecr:DeleteLifecyclePolicy","ecr:BatchCheckLayerAvailability","ecr:InitiateLayerUpload","ecr:UploadLayerPart","ecr:CompleteLayerUpload","ecr:PutImage","ecr:BatchGetImage","ecr:GetDownloadUrlForLayer","ecr:DescribeImages","ecr:StartImageScan","ecr:DescribeImageScanFindings"],"Resource":[${jsonencode(repository_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)},"aws:ResourceTag/Project":${jsonencode(project)}}}},
    {"Sid":"TagProjectRepository","Effect":"Allow","Action":["ecr:TagResource"],"Resource":[${jsonencode(repository_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)},"aws:RequestTag/Project":${jsonencode(project)}},"ForAllValues:StringEquals":{"aws:TagKeys":["Project","ManagedBy","Environment"]}}},
    {"Sid":"UntagProjectRepositoryWithoutChangingOwner","Effect":"Allow","Action":["ecr:UntagResource"],"Resource":[${jsonencode(repository_arn)}],"Condition":{"StringEquals":{"aws:RequestedRegion":${jsonencode(region)}},"ForAllValues:StringEquals":{"aws:TagKeys":["ManagedBy","Environment"]}}}
  ]
}
