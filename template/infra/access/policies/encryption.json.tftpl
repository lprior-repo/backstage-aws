{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "CreateProjectKeysWithOwnershipTag", "Effect": "Allow", "Action": ["kms:CreateKey"], "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:RequestTag/Project": ${jsonencode(name)}}}},
    {"Sid": "TagNewProjectKeys", "Effect": "Allow", "Action": ["kms:TagResource"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:RequestTag/Project": ${jsonencode(name)}, "aws:ResourceTag/Project": ${jsonencode(name)}}, "ForAllValues:StringEquals": {"aws:TagKeys": ["Project", "ManagedBy", "Environment", "Purpose"]}}},
    {"Sid": "ManageOwnedKeys", "Effect": "Allow", "Action": ["kms:DescribeKey", "kms:GetKeyPolicy", "kms:PutKeyPolicy", "kms:EnableKeyRotation", "kms:ListResourceTags", "kms:GetKeyRotationStatus"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}], "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Sid": "DescribeSecretsManagerDefaultKey", "Effect": "Allow", "Action": "kms:DescribeKey", "Resource": ${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}, "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}, "ForAnyValue:StringEquals": {"kms:ResourceAliases": "alias/aws/secretsmanager"}}},
    {"Sid": "ManageExactProjectAliases", "Effect": "Allow", "Action": ["kms:CreateAlias", "kms:UpdateAlias", "kms:DeleteAlias"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:alias/${name}-terraform-state")}, ${jsonencode("arn:${partition}:kms:${region}:${account_id}:alias/${name}-application")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Sid": "AliasTargetsMustBeOwnedKeys", "Effect": "Allow", "Action": ["kms:CreateAlias", "kms:UpdateAlias", "kms:DeleteAlias"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}], "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Sid": "DiscoverProjectAliases", "Effect": "Allow", "Action": ["kms:ListAliases"], "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Sid": "UseOwnedKeysThroughS3WithExactContext", "Effect": "Allow", "Action": ["kms:Encrypt", "kms:Decrypt", "kms:ReEncrypt*", "kms:GenerateDataKey*"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}], "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestedRegion": ${jsonencode(region)}, "kms:ViaService": ${jsonencode("s3.${region}.amazonaws.com")}, "kms:EncryptionContext:aws:s3:arn": ${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-tfstate")}}}},
    {"Sid": "UseOwnedKeysThroughS3ForSeedObjects", "Effect": "Allow", "Action": ["kms:Encrypt", "kms:Decrypt", "kms:ReEncrypt*", "kms:GenerateDataKey*"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}], "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestedRegion": ${jsonencode(region)}, "kms:ViaService": ${jsonencode("s3.${region}.amazonaws.com")}}, "StringLike": {"kms:EncryptionContext:aws:s3:arn": ${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-seed/*")}}}},
    {"Sid": "UseOwnedKeysThroughNamedServices", "Effect": "Allow", "Action": ["kms:Encrypt", "kms:Decrypt", "kms:ReEncrypt*", "kms:GenerateDataKey*"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}], "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestedRegion": ${jsonencode(region)}}, "StringLike": {"kms:ViaService": [${jsonencode("secretsmanager.${region}.amazonaws.com")}, ${jsonencode("logs.${region}.amazonaws.com")}, ${jsonencode("rds.${region}.amazonaws.com")}, ${jsonencode("sns.${region}.amazonaws.com")}]}}},
    {"Sid": "RdsServiceGrantForOwnedKey", "Effect": "Allow", "Action": ["kms:CreateGrant", "kms:ListGrants", "kms:RevokeGrant"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}], "Condition": {"Bool": {"kms:GrantIsForAWSResource": "true"}, "StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestedRegion": ${jsonencode(region)}, "kms:ViaService": ${jsonencode("rds.${region}.amazonaws.com")}}}},
    {"Sid": "RdsSecretsManagerGrantForOwnedKey", "Effect": "Allow", "Action": ["kms:CreateGrant"], "Resource": [${jsonencode("arn:${partition}:kms:${region}:${account_id}:key/*")}], "Condition": {"Bool": {"kms:GrantIsForAWSResource": "true"}, "StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestedRegion": ${jsonencode(region)}, "kms:ViaService": ${jsonencode("secretsmanager.${region}.amazonaws.com")}}}}
  ]
}
