{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "CreateProjectDatabase", "Effect": "Allow", "Action": ["rds:CreateDBInstance", "rds:AddTagsToResource"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:db:${name}-postgres")}, ${jsonencode("arn:${partition}:rds:${region}:${account_id}:subgrp:${name}-database")}, ${jsonencode("arn:${partition}:rds:${region}:${account_id}:pg:${name}-postgres16-*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:RequestTag/Project": ${jsonencode(name)}}}},
    {"Sid": "UseDefaultOptionGroupForProjectDatabase", "Effect": "Allow", "Action": ["rds:CreateDBInstance"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:og:default:postgres-16")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:RequestTag/Project": ${jsonencode(name)}}}},
    {"Sid": "MutateOwnedProjectDatabase", "Effect": "Allow", "Action": ["rds:ModifyDBInstance", "rds:DeleteDBInstance"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:db:${name}-postgres")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:ResourceTag/Project": ${jsonencode(name)}}}},
    {"Sid": "CreateFinalDatabaseSnapshot", "Effect": "Allow", "Action": ["rds:CreateDBSnapshot", "rds:DescribeDBSnapshots"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:db:${name}-postgres")}, ${jsonencode("arn:${partition}:rds:${region}:${account_id}:snapshot:${name}-final")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Sid": "TagOwnedProjectDatabase", "Effect": "Allow", "Action": ["rds:AddTagsToResource"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:db:${name}-postgres")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestTag/Project": ${jsonencode(name)}}, "ForAllValues:StringEquals": {"aws:TagKeys": ["Project", "ManagedBy", "Environment"]}}},
    {"Sid": "UntagOwnedProjectDatabaseWithoutChangingOwner", "Effect": "Allow", "Action": ["rds:RemoveTagsFromResource"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:db:${name}-postgres")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:ResourceTag/Project": ${jsonencode(name)}}, "ForAllValues:StringEquals": {"aws:TagKeys": ["ManagedBy", "Environment"]}}},
    {"Sid": "ReadProjectDatabase", "Effect": "Allow", "Action": ["rds:ListTagsForResource"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:db:${name}-postgres")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Sid": "ListRegionalDatabaseMetadata", "Effect": "Allow", "Action": "rds:DescribeDBInstances", "Resource": ${jsonencode("arn:${partition}:rds:${region}:${account_id}:db:*")}, "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Sid": "CreateProjectRdsGroups", "Effect": "Allow", "Action": ["rds:CreateDBSubnetGroup", "rds:CreateDBParameterGroup", "rds:AddTagsToResource"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:subgrp:${name}-database")}, ${jsonencode("arn:${partition}:rds:${region}:${account_id}:pg:${name}-postgres16-*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:RequestTag/Project": ${jsonencode(name)}}}},
    {"Sid": "MutateOwnedRdsGroups", "Effect": "Allow", "Action": ["rds:ModifyDBSubnetGroup", "rds:DeleteDBSubnetGroup", "rds:ModifyDBParameterGroup", "rds:ResetDBParameterGroup", "rds:DeleteDBParameterGroup"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:subgrp:${name}-database")}, ${jsonencode("arn:${partition}:rds:${region}:${account_id}:pg:${name}-postgres16-*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:ResourceTag/Project": ${jsonencode(name)}}}},
    {"Sid": "TagOwnedRdsGroups", "Effect": "Allow", "Action": ["rds:AddTagsToResource"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:subgrp:${name}-database")}, ${jsonencode("arn:${partition}:rds:${region}:${account_id}:pg:${name}-postgres16-*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:ResourceTag/Project": ${jsonencode(name)}, "aws:RequestTag/Project": ${jsonencode(name)}}, "ForAllValues:StringEquals": {"aws:TagKeys": ["Project", "ManagedBy", "Environment"]}}},
    {"Sid": "UntagOwnedRdsGroupsWithoutChangingOwner", "Effect": "Allow", "Action": ["rds:RemoveTagsFromResource"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:subgrp:${name}-database")}, ${jsonencode("arn:${partition}:rds:${region}:${account_id}:pg:${name}-postgres16-*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:ResourceTag/Project": ${jsonencode(name)}}, "ForAllValues:StringEquals": {"aws:TagKeys": ["ManagedBy", "Environment"]}}},
    {"Sid": "ReadProjectRdsGroups", "Effect": "Allow", "Action": ["rds:DescribeDBSubnetGroups", "rds:DescribeDBParameterGroups", "rds:DescribeDBParameters", "rds:ListTagsForResource"], "Resource": [${jsonencode("arn:${partition}:rds:${region}:${account_id}:subgrp:${name}-database")}, ${jsonencode("arn:${partition}:rds:${region}:${account_id}:pg:${name}-postgres16-*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}}
  ]
}
