{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["s3:CreateBucket", "s3:GetBucketLocation", "s3:GetBucketAcl", "s3:GetBucketTagging", "s3:PutBucketTagging", "s3:GetBucketVersioning", "s3:PutBucketVersioning", "s3:GetBucketPublicAccessBlock", "s3:PutBucketPublicAccessBlock", "s3:GetBucketOwnershipControls", "s3:PutBucketOwnershipControls", "s3:GetEncryptionConfiguration", "s3:PutEncryptionConfiguration", "s3:GetBucketPolicy", "s3:GetLifecycleConfiguration", "s3:GetAccelerateConfiguration", "s3:GetBucketCORS", "s3:GetBucketLogging", "s3:GetBucketObjectLockConfiguration", "s3:GetBucketRequestPayment", "s3:GetBucketWebsite", "s3:GetReplicationConfiguration", "s3:PutBucketPolicy"], "Resource": [${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-tfstate")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"], "Resource": [${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-tfstate/base/terraform.tfstate")}, ${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-tfstate/base/terraform.tfstate.tflock")}, ${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-tfstate/bootstrap/terraform.tfstate")}, ${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-tfstate/bootstrap/terraform.tfstate.tflock")}, ${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-tfstate/env/*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["s3:ListBucket"], "Resource": [${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-tfstate")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["s3:CreateBucket", "s3:GetBucketLocation", "s3:ListBucket", "s3:GetBucketAcl", "s3:GetBucketTagging", "s3:PutBucketTagging", "s3:GetBucketPublicAccessBlock", "s3:PutBucketPublicAccessBlock", "s3:GetEncryptionConfiguration", "s3:PutEncryptionConfiguration", "s3:GetBucketPolicy", "s3:PutBucketPolicy", "s3:GetBucketVersioning", "s3:PutBucketVersioning", "s3:GetLifecycleConfiguration", "s3:PutLifecycleConfiguration", "s3:DeleteBucket", "s3:DeleteBucketPolicy", "s3:GetAccelerateConfiguration", "s3:GetBucketCORS", "s3:GetBucketLogging", "s3:GetBucketObjectLockConfiguration", "s3:GetBucketRequestPayment", "s3:GetBucketWebsite", "s3:GetReplicationConfiguration"], "Resource": [${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-seed")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["s3:GetObject", "s3:PutObject"], "Resource": [${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-seed/*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["s3:GetBucketLocation", "s3:GetBucketAcl", "s3:GetBucketTagging", "s3:GetBucketPublicAccessBlock", "s3:GetBucketVersioning", "s3:GetEncryptionConfiguration", "s3:GetBucketPolicy", "s3:ListBucket", "s3:GetLifecycleConfiguration", "s3:GetAccelerateConfiguration", "s3:GetBucketCORS", "s3:GetBucketLogging", "s3:GetBucketObjectLockConfiguration", "s3:GetBucketRequestPayment", "s3:GetBucketWebsite", "s3:GetReplicationConfiguration"], "Resource": [${jsonencode("arn:${partition}:s3:::${name}-${account_id}-${region}-audit")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["logs:CreateLogGroup"], "Resource": [${jsonencode("arn:${partition}:logs:${region}:${account_id}:log-group:/backstage/${name}/*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:RequestTag/Project": ${jsonencode(name)}}}},
    {"Effect": "Allow", "Action": ["logs:DeleteLogGroup", "logs:PutRetentionPolicy", "logs:DeleteRetentionPolicy", "logs:AssociateKmsKey", "logs:DisassociateKmsKey", "logs:ListTagsForResource"], "Resource": [${jsonencode("arn:${partition}:logs:${region}:${account_id}:log-group:/backstage/${name}/*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["logs:TagResource"], "Resource": [${jsonencode("arn:${partition}:logs:${region}:${account_id}:log-group:/backstage/${name}/*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}, "aws:RequestTag/Project": ${jsonencode(name)}}, "ForAllValues:StringEquals": {"aws:TagKeys": ["Project", "ManagedBy", "Environment", "Purpose"]}}},
    {"Effect": "Allow", "Action": ["logs:UntagResource"], "Resource": [${jsonencode("arn:${partition}:logs:${region}:${account_id}:log-group:/backstage/${name}/*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}, "ForAllValues:StringEquals": {"aws:TagKeys": ["ManagedBy", "Environment", "Purpose"]}}},
    {"Effect": "Allow", "Action": ["logs:FilterLogEvents", "logs:DescribeLogStreams"], "Resource": [${jsonencode("arn:${partition}:logs:${region}:${account_id}:log-group:/backstage/${name}/*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["logs:GetLogEvents"], "Resource": [${jsonencode("arn:${partition}:logs:${region}:${account_id}:log-group:/backstage/${name}/*:log-stream:*")}], "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["logs:DescribeLogGroups"], "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}}
  ]
}
