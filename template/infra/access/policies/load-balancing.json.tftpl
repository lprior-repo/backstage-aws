{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid": "DescribeRegionalLoadBalancing", "Effect": "Allow", "Action": ["elasticloadbalancing:DescribeLoadBalancers", "elasticloadbalancing:DescribeLoadBalancerAttributes", "elasticloadbalancing:DescribeListeners", "elasticloadbalancing:DescribeListenerAttributes", "elasticloadbalancing:DescribeRules", "elasticloadbalancing:DescribeTargetGroups", "elasticloadbalancing:DescribeTargetGroupAttributes", "elasticloadbalancing:DescribeTargetHealth", "elasticloadbalancing:DescribeTags"], "Resource": "*", "Condition": {"StringEquals": {"aws:RequestedRegion": ${jsonencode(region)}}}},
    {"Sid": "CreateProjectLoadBalancer", "Effect": "Allow", "Action": "elasticloadbalancing:CreateLoadBalancer", "Resource": ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/${name}-alb/*")}, "Condition": {"StringEquals": {"aws:RequestTag/Project": ${jsonencode(name)}}}},
    {"Sid": "CreateProjectListener", "Effect": "Allow", "Action": "elasticloadbalancing:CreateListener", "Resource": ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/${name}-alb/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}}}},
    {"Sid": "CreateProjectRule", "Effect": "Allow", "Action": "elasticloadbalancing:CreateRule", "Resource": ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:listener/app/${name}-alb/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}}}},
    {"Sid": "CreateProjectTargets", "Effect": "Allow", "Action": "elasticloadbalancing:CreateTargetGroup", "Resource": ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:targetgroup/bs-*/*")}, "Condition": {"StringEquals": {"aws:RequestTag/Project": ${jsonencode(name)}}}},
    {"Sid": "TagNewLoadBalancingResources", "Effect": "Allow", "Action": "elasticloadbalancing:AddTags", "Resource": [${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/${name}-alb/*")}, ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:listener/app/${name}-alb/*")}, ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:listener-rule/app/${name}-alb/*")}, ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:targetgroup/bs-*/*")}], "Condition": {"StringEquals": {"elasticloadbalancing:CreateAction": ["CreateLoadBalancer", "CreateListener", "CreateRule", "CreateTargetGroup"], "aws:RequestTag/Project": ${jsonencode(name)}}}},
    {"Sid": "MaintainProjectLoadBalancing", "Effect": "Allow", "Action": ["elasticloadbalancing:DeleteLoadBalancer", "elasticloadbalancing:ModifyLoadBalancerAttributes", "elasticloadbalancing:SetSecurityGroups", "elasticloadbalancing:SetSubnets", "elasticloadbalancing:SetIpAddressType", "elasticloadbalancing:SetRulePriorities", "elasticloadbalancing:DeleteListener", "elasticloadbalancing:ModifyListener", "elasticloadbalancing:ModifyListenerAttributes", "elasticloadbalancing:ModifyRule", "elasticloadbalancing:DeleteRule", "elasticloadbalancing:ModifyTargetGroup", "elasticloadbalancing:ModifyTargetGroupAttributes", "elasticloadbalancing:DeleteTargetGroup", "elasticloadbalancing:RegisterTargets", "elasticloadbalancing:DeregisterTargets", "elasticloadbalancing:AddTags", "elasticloadbalancing:RemoveTags"], "Resource": [${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:loadbalancer/app/${name}-alb/*")}, ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:listener/app/${name}-alb/*")}, ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:listener-rule/app/${name}-alb/*")}, ${jsonencode("arn:${partition}:elasticloadbalancing:${region}:${account_id}:targetgroup/bs-*/*")}], "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}}}}
  ]
}
