{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect": "Allow", "Action": ["ec2:DescribeAccountAttributes", "ec2:DescribeAddresses", "ec2:DescribeAddressesAttribute", "ec2:DescribeInstanceAttribute", "ec2:DescribeAvailabilityZones", "ec2:DescribeFlowLogs", "ec2:DescribeImages", "ec2:DescribeInstanceStatus", "ec2:DescribeInstanceCreditSpecifications", "ec2:DescribeInstanceTypes", "ec2:DescribeInstances", "ec2:DescribeInternetGateways", "ec2:DescribeNatGateways", "ec2:DescribeNetworkAcls", "ec2:DescribeNetworkInterfaceAttribute", "ec2:DescribeNetworkInterfaces", "ec2:DescribeRouteTables", "ec2:DescribeSecurityGroupRules", "ec2:DescribeSecurityGroups", "ec2:DescribeSubnets", "ec2:DescribeTags", "ec2:DescribeVolumes", "ec2:DescribeVpcAttribute", "ec2:DescribeVpcs"], "Resource": "*", "Condition": {"StringEquals": {"ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateVpc", "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:vpc/*")}, "Condition": {"StringEquals": {"aws:RequestTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["ec2:DeleteVpc", "ec2:ModifyVpcAttribute"], "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:vpc/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateInternetGateway", "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:internet-gateway/*")}, "Condition": {"StringEquals": {"aws:RequestTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["ec2:DeleteInternetGateway", "ec2:AttachInternetGateway", "ec2:DetachInternetGateway"], "Resource": [${jsonencode("arn:${partition}:ec2:${region}:${account_id}:internet-gateway/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:vpc/*")}], "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateSubnet", "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:subnet/*")}, "Condition": {"StringEquals": {"aws:RequestTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateSubnet", "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:vpc/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["ec2:DeleteSubnet", "ec2:ModifySubnetAttribute"], "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:subnet/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateRouteTable", "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:route-table/*")}, "Condition": {"StringEquals": {"aws:RequestTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateRouteTable", "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:vpc/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["ec2:DeleteRouteTable", "ec2:CreateRoute", "ec2:ReplaceRoute", "ec2:DeleteRoute"], "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:route-table/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["ec2:AssociateRouteTable", "ec2:DisassociateRouteTable", "ec2:ReplaceRouteTableAssociation"], "Resource": [${jsonencode("arn:${partition}:ec2:${region}:${account_id}:route-table/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:subnet/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:internet-gateway/*")}], "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateSecurityGroup", "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:security-group/*")}, "Condition": {"StringEquals": {"aws:RequestTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateSecurityGroup", "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:vpc/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress", "ec2:RevokeSecurityGroupIngress", "ec2:RevokeSecurityGroupEgress", "ec2:ModifySecurityGroupRules", "ec2:UpdateSecurityGroupRuleDescriptionsIngress", "ec2:UpdateSecurityGroupRuleDescriptionsEgress"], "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:security-group/*")}, "Condition": {"StringEquals": {"aws:ResourceTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:AuthorizeSecurityGroupEgress"], "Resource": ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:security-group-rule/*")}, "Condition": {"StringEquals": {"aws:RequestTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}},
    {"Effect": "Allow", "Action": "ec2:CreateTags", "Resource": [${jsonencode("arn:${partition}:ec2:${region}:${account_id}:vpc/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:subnet/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:internet-gateway/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:route-table/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:security-group/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:security-group-rule/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:instance/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:volume/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:network-interface/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:elastic-ip/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:vpc-flow-log/*")}, ${jsonencode("arn:${partition}:ec2:${region}:${account_id}:natgateway/*")}], "Condition": {"StringEquals": {"ec2:CreateAction": ["AllocateAddress", "AuthorizeSecurityGroupEgress", "AuthorizeSecurityGroupIngress", "CreateFlowLogs", "CreateInternetGateway", "CreateNetworkInterface", "CreateRouteTable", "CreateSecurityGroup", "CreateSubnet", "CreateVpc", "RunInstances", "CreateNatGateway"], "aws:RequestTag/Project": ${jsonencode(name)}, "ec2:Region": ${jsonencode(region)}}}}
  ]
}
