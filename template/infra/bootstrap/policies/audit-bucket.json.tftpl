{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrailACL",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": ${jsonencode(audit_bucket_arn)},
      "Condition": {
        "StringEquals": {
          "aws:SourceArn": ${jsonencode(cloudtrail_trail_arn)}
        }
      }
    },
    {
      "Sid": "TrailWrite",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudtrail.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": ${jsonencode(cloudtrail_logs_object_arn)},
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceArn": ${jsonencode(cloudtrail_trail_arn)}
        }
      }
    },
    {
      "Sid": "TLSOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ${jsonencode(audit_bucket_resources)},
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
