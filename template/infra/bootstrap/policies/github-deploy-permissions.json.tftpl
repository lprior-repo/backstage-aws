{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:DescribeImageScanFindings",
        "ecr:DescribeRepositories",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart",
        "ecr:StartImageScan"
      ],
      "Resource": ${jsonencode(ecr_portal_repository_arn)}
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:CreateService",
        "ecs:DeleteService",
        "ecs:TagResource",
        "ecs:UpdateService"
      ],
      "Resource": ${jsonencode(ecs_service_arn)}
    },
    {
      "Effect": "Allow",
      "Action": "ecs:TagResource",
      "Resource": ${jsonencode(ecs_task_definition_arn)}
    },
    {
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:Describe*",
        "ecs:List*"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "elasticloadbalancing:Describe*",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "ecs:DescribeTasks",
      "Resource": ${jsonencode(ecs_task_arn)}
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": ${jsonencode(task_role_arns)},
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateTargetGroup",
        "elasticloadbalancing:AddTags"
      ],
      "Resource": ${jsonencode(elasticloadbalancing_target_group_arn)},
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": ${jsonencode(project_name)}
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:ModifyTargetGroup",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:DeleteTargetGroup"
      ],
      "Resource": ${jsonencode(elasticloadbalancing_target_group_arn)},
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": ${jsonencode(project_name)}
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateRule",
        "elasticloadbalancing:ModifyRule",
        "elasticloadbalancing:DeleteRule",
        "elasticloadbalancing:AddTags"
      ],
      "Resource": ${jsonencode(elasticloadbalancing_listener_arns)}
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:AssociateKmsKey",
        "logs:DisassociateKmsKey",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": ${jsonencode(log_group_arn)}
    },
    {
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": ${jsonencode(state_bucket_arn)}
    },
    {
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": ${jsonencode(base_state_object_arn)}
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": ${jsonencode(environment_state_object_arn)}
    },
    {
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": ${jsonencode(state_kms_key_arn)}
    }
  ]
}
